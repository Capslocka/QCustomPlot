@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Core Gui Widgets PrintSupport)
if(@QCUSTOMPLOT_USE_OPENGL@)
  find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS OpenGL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QCustomPlotTargets.cmake")

check_required_components(QCustomPlot)
